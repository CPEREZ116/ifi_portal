 {
  "absolute_value": 0,
  "align_labels_right": 0,
  "css": "",
  "custom_format": 1,
  "default_print_language": "es",
  "disabled": 0,
  "doc_type": "Planilla",
  "docstatus": 0,
  "doctype": "Print Format",
  "font": null,
  "font_size": 14,
  "format_data": null,
  "html": "<style>\r\n\r\n/*=============================================================\r\n=            IFI DESIGN SYSTEM V4                             =\r\n=============================================================*/\r\n\r\n@page{\r\n    size: Letter landscape;\r\n    margin:12mm;\r\n}\r\n\r\n:root{\r\n\r\n    --ifi-primary:#0f4c81;\r\n    --ifi-primary-dark:#0b3559;\r\n    --ifi-primary-light:#eef5fb;\r\n\r\n    --ifi-success:#2e7d32;\r\n    --ifi-warning:#f39c12;\r\n    --ifi-danger:#c0392b;\r\n\r\n    --ifi-border:#d8dee9;\r\n\r\n    --ifi-title:#1b365d;\r\n    --ifi-text:#374151;\r\n    --ifi-muted:#6b7280;\r\n\r\n    --ifi-bg:#ffffff;\r\n    --ifi-card:#f8fafc;\r\n\r\n    --radius:8px;\r\n\r\n}\r\n\r\n/*=============================================================\r\n=            GENERAL                                          =\r\n=============================================================*/\r\n\r\n*{\r\n    box-sizing:border-box;\r\n}\r\n\r\nbody{\r\n\r\n    font-family:\r\n        \"Segoe UI\",\r\n        Arial,\r\n        Helvetica,\r\n        sans-serif;\r\n\r\n    color:var(--ifi-text);\r\n\r\n    font-size:11px;\r\n\r\n    background:white;\r\n\r\n}\r\n\r\n.ifi-page{\r\n\r\n    width:100%;\r\n\r\n}\r\n\r\n/*=============================================================\r\n=            TITLES                                           =\r\n=============================================================*/\r\n\r\nh1{\r\n\r\n    margin:0;\r\n\r\n    font-size:28px;\r\n\r\n    color:var(--ifi-title);\r\n\r\n    font-weight:700;\r\n\r\n}\r\n\r\nh2{\r\n\r\n    margin:0;\r\n\r\n    font-size:18px;\r\n\r\n    color:var(--ifi-title);\r\n\r\n}\r\n\r\nh3{\r\n\r\n    margin:0;\r\n\r\n    font-size:14px;\r\n\r\n}\r\n\r\n/*=============================================================\r\n=            CARDS                                             =\r\n=============================================================*/\r\n\r\n.ifi-card{\r\n\r\n    border:1px solid var(--ifi-border);\r\n\r\n    border-radius:var(--radius);\r\n\r\n    background:white;\r\n\r\n    padding:14px;\r\n\r\n}\r\n\r\n.ifi-shadow{\r\n\r\n    box-shadow:0 2px 8px rgba(0,0,0,.05);\r\n\r\n}\r\n\r\n/*=============================================================\r\n=            TABLES                                            =\r\n=============================================================*/\r\n\r\ntable{\r\n\r\n    width:100%;\r\n\r\n    border-collapse:collapse;\r\n\r\n}\r\n\r\nth{\r\n\r\n    background:var(--ifi-primary);\r\n\r\n    color:white;\r\n\r\n    font-weight:600;\r\n\r\n    padding:7px;\r\n\r\n    border:1px solid var(--ifi-primary);\r\n\r\n}\r\n\r\ntd{\r\n\r\n    padding:6px;\r\n\r\n    border:1px solid var(--ifi-border);\r\n\r\n}\r\n\r\n.text-right{\r\n\r\n    text-align:right;\r\n\r\n}\r\n\r\n.text-center{\r\n\r\n    text-align:center;\r\n\r\n}\r\n\r\n.small{\r\n\r\n    font-size:10px;\r\n\r\n    color:var(--ifi-muted);\r\n\r\n}\r\n\r\n/*=============================================================\r\n=            BADGES                                            =\r\n=============================================================*/\r\n\r\n.badge{\r\n\r\n    display:inline-block;\r\n\r\n    padding:4px 10px;\r\n\r\n    border-radius:15px;\r\n\r\n    font-size:10px;\r\n\r\n    font-weight:bold;\r\n\r\n}\r\n\r\n.badge-success{\r\n\r\n    background:#dff3e2;\r\n\r\n    color:#1d6f42;\r\n\r\n}\r\n\r\n.badge-warning{\r\n\r\n    background:#fff5d8;\r\n\r\n    color:#8a6200;\r\n\r\n}\r\n\r\n.badge-danger{\r\n\r\n    background:#fde4e4;\r\n\r\n    color:#9b1c1c;\r\n\r\n}\r\n\r\n/*=============================================================\r\n=            SPACING                                           =\r\n=============================================================*/\r\n\r\n.mt-10{margin-top:10px;}\r\n.mt-15{margin-top:15px;}\r\n.mt-20{margin-top:20px;}\r\n.mb-10{margin-bottom:10px;}\r\n.mb-20{margin-bottom:20px;}\r\n\r\n</style>\r\n\r\n<!-- ========================================================= -->\r\n<!-- ENCABEZADO INSTITUCIONAL IFI -->\r\n<!-- ========================================================= -->\r\n\r\n<style>\r\n\r\n.ifi-header{\r\n    width:100%;\r\n    border:1px solid var(--ifi-border);\r\n    border-radius:10px;\r\n    overflow:hidden;\r\n    margin-bottom:8px;\r\n}\r\n\r\n.ifi-header-table{\r\n    width:100%;\r\n    border-collapse:collapse;\r\n}\r\n\r\n.ifi-header-table td{\r\n    border:none;\r\n    vertical-align:middle;\r\n    padding:8px 12px;\r\n}\r\n\r\n.ifi-logo{\r\n    width:12%;;\r\n    text-align:center;\r\n    border-right:1px solid var(--ifi-border);\r\n}\r\n\r\n.logo-box{\r\n    width:45px;\r\n    height:45px;\r\n    font-size:9px;\r\n}\r\n\r\n.ifi-title{\r\n\r\n    width:63%;\r\n\r\n    text-align:center;\r\n\r\n}\r\n\r\n.ifi-title h1{\r\n\r\n    font-size:22px;\r\n\r\n    margin:0;\r\n\r\n    line-height:1.1;\r\n\r\n}\r\n\r\n.ifi-title h2{\r\n\r\n    margin-top:2px;\r\n\r\n    font-size:10px;\r\n\r\n}\r\n\r\n.ifi-meta{\r\n\r\n     width:23%;\r\n\r\n    border-left:1px solid var(--ifi-border);\r\n\r\n    background:#fafbfd;\r\n\r\n}\r\n\r\n.meta-table{\r\n\r\n    width:100%;\r\n\r\n    border-collapse:collapse;\r\n\r\n}\r\n\r\n.meta-table td{\r\n\r\n    border:none;\r\n\r\n    padding:2px 2px;\r\n\r\n    line-height:1.1;\r\n\r\n}\r\n\r\n.meta-label{\r\n\r\n    font-weight:bold;\r\n\r\n    color:var(--ifi-title);\r\n\r\n    width:40%;\r\n\r\n}\r\n\r\n.meta-value{\r\n\r\n    text-align:right;\r\n\r\n}\r\n\r\n.estado-aprobado{\r\n\r\n    display:inline-block;\r\n\r\n    padding:5px 10px;\r\n\r\n    border-radius:20px;\r\n\r\n    background:#e7f7eb;\r\n\r\n    color:#1f7a3d;\r\n\r\n    font-weight:700;\r\n\r\n    font-size:10px;\r\n\r\n}\r\n\r\n</style>\r\n\r\n<div class=\"ifi-header\">\r\n\r\n<table class=\"ifi-header-table\">\r\n\r\n<tr>\r\n\r\n<td class=\"ifi-logo\">\r\n\r\n    <!-- Cambiar por el logo cuando lo tengamos -->\r\n    <div class=\"logo-box\">\r\n\r\n        LOGO<br>IFI\r\n\r\n    </div>\r\n\r\n</td>\r\n\r\n<td class=\"ifi-title\">\r\n\r\n    <h1>PLANILLA DE DONACIONES</h1>\r\n\r\n    <h2>Detalle de Recaudo y Consignaciones</h2>\r\n\r\n</td>\r\n\r\n<td class=\"ifi-meta\">\r\n\r\n<table class=\"meta-table\">\r\n\r\n<tr>\r\n\r\n<td class=\"meta-label\">\r\nNo.\r\n</td>\r\n\r\n<td class=\"meta-value\">\r\n\r\n{{ doc.name }}\r\n\r\n</td>\r\n\r\n</tr>\r\n\r\n<tr>\r\n\r\n<td class=\"meta-label\">\r\nFecha\r\n</td>\r\n\r\n<td class=\"meta-value\">\r\n\r\n{{ frappe.utils.formatdate(doc.fecha) }}\r\n\r\n</td>\r\n\r\n</tr>\r\n\r\n<tr>\r\n\r\n<td class=\"meta-label\">\r\nEstado\r\n</td>\r\n\r\n<td class=\"meta-value\">\r\n\r\n<span class=\"estado-aprobado\">\r\n\r\n{{ doc.workflow_state or doc.status or doc.estado or \"BORRADOR\" }}\r\n\r\n</span>\r\n\r\n</td>\r\n\r\n</tr>\r\n\r\n<tr>\r\n\r\n<td class=\"meta-label\">\r\nUsuario\r\n</td>\r\n\r\n<td class=\"meta-value\">\r\n\r\n{{ frappe.session.user }}\r\n\r\n</td>\r\n\r\n</tr>\r\n\r\n</table>\r\n\r\n</td>\r\n\r\n</tr>\r\n\r\n</table>\r\n\r\n</div>\r\n\r\n<!-- ========================================================= -->\r\n<!-- DASHBOARD SUPERIOR -->\r\n<!-- ========================================================= -->\r\n\r\n<style>\r\n\r\n.ifi-dashboard{\r\n\r\n    display:flex;\r\n\r\n     gap:6px;\r\n\r\n    margin-bottom:8px;\r\n\r\n}\r\n\r\n.ifi-panel{\r\n\r\n    flex:1;\r\n\r\n    border:1px solid var(--ifi-border);\r\n\r\n    border-radius:8px;\r\n\r\n    overflow:hidden;\r\n\r\n    background:white;\r\n\r\n}\r\n\r\n.ifi-panel-title{\r\n\r\n    background:var(--ifi-primary);\r\n\r\n    color:white;\r\n\r\n    padding:5px 10px;\r\n\r\n    font-size:11px;\r\n\r\n    font-weight:bold;\r\n\r\n    letter-spacing:.5px;\r\n\r\n}\r\n\r\n.ifi-panel-body{\r\n\r\n     padding:5px;\r\n\r\n}\r\n\r\n.info-table{\r\n\r\n    width:100%;\r\n\r\n    border-collapse:collapse;\r\n\r\n}\r\n\r\n.info-table td{\r\n\r\n    border:none;\r\n\r\n    padding:1px 0;\r\n\r\n    font-size:10px;\r\n\r\n}\r\n\r\n.info-label{\r\n\r\n    width:42%;\r\n\r\n    color:var(--ifi-muted);\r\n\r\n    font-weight:600;\r\n\r\n}\r\n\r\n.info-value{\r\n\r\n    color:#1b365d;\r\n\r\n    font-weight:600;\r\n\r\n    text-align:right;\r\n\r\n}\r\n\r\n.total-box{\r\n\r\n    display:flex;\r\n\r\n    justify-content:space-between;\r\n\r\n    align-items:center;\r\n\r\n    margin-bottom:4px;\r\n\r\n    padding:5px 6px;\r\n\r\n    border-radius:6px;\r\n\r\n    background:#f8fafc;\r\n\r\n}\r\n\r\n.total-box:last-child{\r\n\r\n    margin-bottom:0;\r\n\r\n}\r\n\r\n.total-label{\r\n\r\n    color:#4b5563;\r\n\r\n    font-weight:600;\r\n\r\n}\r\n\r\n.total-value{\r\n\r\n    font-size:13px;\r\n\r\n    font-weight:bold;\r\n\r\n    color:var(--ifi-primary-dark);\r\n\r\n}\r\n\r\n.total-diff{\r\n\r\n    color:#b91c1c;\r\n\r\n}\r\n\r\n.total-ok{\r\n\r\n    color:#166534;\r\n\r\n}\r\n\r\n\r\n/*=========================================================\r\n=            DASHBOARD V5.3                               =\r\n=========================================================*/\r\n\r\n.dashboard-v53{\r\n\r\n    width:100%;\r\n\r\n    border:1px solid var(--ifi-border);\r\n\r\n    border-radius:8px;\r\n\r\n    overflow:hidden;\r\n\r\n    margin-bottom:10px;\r\n\r\n}\r\n\r\n.dashboard-v53 table{\r\n\r\n    width:100%;\r\n\r\n    border-collapse:collapse;\r\n\r\n}\r\n\r\n.dashboard-v53 th{\r\n\r\n    background:var(--ifi-primary);\r\n\r\n    color:white;\r\n\r\n    padding:6px;\r\n\r\n    font-size:11px;\r\n\r\n    border:none;\r\n\r\n}\r\n\r\n.dashboard-v53 td{\r\n\r\n    border:none;\r\n\r\n    border-right:1px solid #e5e7eb;\r\n\r\n    vertical-align:top;\r\n\r\n    padding:8px;\r\n\r\n}\r\n\r\n.dashboard-v53 td:last-child{\r\n\r\n    border-right:none;\r\n\r\n}\r\n\r\n.info-line{\r\n\r\n    display:flex;\r\n\r\n    justify-content:space-between;\r\n\r\n    margin-bottom:4px;\r\n\r\n    font-size:10px;\r\n\r\n}\r\n\r\n.info-line:last-child{\r\n\r\n    margin-bottom:0;\r\n\r\n}\r\n\r\n.info-name{\r\n\r\n    color:#6b7280;\r\n\r\n}\r\n\r\n.info-value{\r\n\r\n    font-weight:600;\r\n\r\n    color:#1b365d;\r\n\r\n}\r\n\r\n.total-ok{\r\n\r\n    color:#166534;\r\n\r\n    font-weight:bold;\r\n\r\n}\r\n\r\n.total-diff{\r\n\r\n    color:#b91c1c;\r\n\r\n    font-weight:bold;\r\n\r\n}\r\n\r\n</style>\r\n\r\n<div class=\"dashboard-v53\">\r\n\r\n<table>\r\n\r\n<thead>\r\n\r\n<tr>\r\n\r\n<th>INFORMACIÓN GENERAL</th>\r\n\r\n<th>UNIDAD ORGANIZACIONAL</th>\r\n\r\n<th>RESUMEN FINANCIERO</th>\r\n\r\n</tr>\r\n\r\n</thead>\r\n\r\n<tbody>\r\n\r\n<tr>\r\n\r\n<td>\r\n\r\n<div class=\"info-line\">\r\n<span class=\"info-name\">Fecha</span>\r\n<span class=\"info-value\">{{ frappe.utils.formatdate(doc.fecha) }}</span>\r\n</div>\r\n\r\n<div class=\"info-line\">\r\n<span class=\"info-name\">Calendario</span>\r\n<span class=\"info-value\">{{ doc.calendario or \"-\" }}</span>\r\n</div>\r\n\r\n<div class=\"info-line\">\r\n<span class=\"info-name\">Entrega</span>\r\n<span class=\"info-value\">{{ doc.entrega or \"-\" }}</span>\r\n</div>\r\n\r\n</td>\r\n\r\n<td>\r\n\r\n<div class=\"info-line\">\r\n<span class=\"info-name\">Unidad</span>\r\n<span class=\"info-value\">{{ doc.unidad_organizacional }}</span>\r\n</div>\r\n\r\n<div class=\"info-line\">\r\n<span class=\"info-name\">Responsable</span>\r\n<span class=\"info-value\">{{ doc.usuario_responsable_actual or \"-\" }}</span>\r\n</div>\r\n\r\n<div class=\"info-line\">\r\n<span class=\"info-name\">Cuenta</span>\r\n<span class=\"info-value\">{{ doc.cuenta_consignacion or \"-\" }}</span>\r\n</div>\r\n\r\n</td>\r\n\r\n<td>\r\n\r\n<div class=\"info-line\">\r\n<span class=\"info-name\">Recaudado</span>\r\n<span class=\"info-value\">{{ frappe.format_value(doc.total_recaudado,\"Currency\") }}</span>\r\n</div>\r\n\r\n<div class=\"info-line\">\r\n<span class=\"info-name\">Consignado</span>\r\n<span class=\"info-value\">{{ frappe.format_value(doc.total_consignado,\"Currency\") }}</span>\r\n</div>\r\n\r\n<div class=\"info-line\">\r\n<span class=\"info-name\">Diferencia</span>\r\n\r\n<span class=\"info-value {% if (doc.diferencia_consignacion or 0)==0 %}total-ok{% else %}total-diff{% endif %}\">\r\n\r\n{{ frappe.format_value(doc.diferencia_consignacion,\"Currency\") }}\r\n\r\n</span>\r\n\r\n</div>\r\n\r\n</td>\r\n\r\n</tr>\r\n\r\n</tbody>\r\n\r\n</table>\r\n\r\n</div>\r\n\r\n\r\n\r\n<style>\r\n\r\n/*=============================================================\r\n=            RECIBOS                                           =\r\n=============================================================*/\r\n\r\n.recibo-card{\r\n\r\n    border:1px solid var(--ifi-border);\r\n\r\n    border-radius:8px;\r\n\r\n    margin-bottom:18px;\r\n\r\n    overflow:hidden;\r\n\r\n    page-break-inside:avoid;\r\n\r\n}\r\n\r\n.recibo-header{\r\n\r\n    display:flex;\r\n\r\n    justify-content:space-between;\r\n\r\n    align-items:center;\r\n\r\n    background:var(--ifi-primary-light);\r\n\r\n     padding:6px 10px;\r\n\r\n    border-bottom:1px solid var(--ifi-border);\r\n\r\n}\r\n\r\n.recibo-numero{\r\n\r\n    font-size:16px;\r\n\r\n    font-weight:bold;\r\n\r\n    color:var(--ifi-primary-dark);\r\n\r\n}\r\n\r\n.recibo-total{\r\n\r\n    font-size:18px;\r\n\r\n    font-weight:bold;\r\n\r\n    color:var(--ifi-primary-dark);\r\n\r\n}\r\n\r\n.recibo-body{\r\n\r\n    padding:8px;\r\n\r\n}\r\n\r\n.recibo-info{\r\n\r\n    display:flex;\r\n\r\n    justify-content:space-between;\r\n\r\n    margin-bottom:14px;\r\n\r\n}\r\n\r\n.recibo-col{\r\n\r\n    width:32%;\r\n\r\n}\r\n\r\n.recibo-label{\r\n\r\n    color:var(--ifi-muted);\r\n\r\n    font-size:9px;\r\n\r\n    margin-bottom:3px;\r\n\r\n}\r\n\r\n.recibo-value{\r\n\r\n    font-weight:600;\r\n    font-size:10px;\r\n    color:#1f2937;\r\n\r\n}\r\n\r\n.conceptos-table{\r\n\r\n    margin-top:8px;\r\n\r\n}\r\n\r\n.conceptos-table th{\r\n\r\n    background:#eef5fb;\r\n\r\n    color:#1b365d;\r\n\r\n    border:1px solid var(--ifi-border);\r\n\r\n}\r\n\r\n.total-final{\r\n\r\n    text-align:right;\r\n\r\n    margin-top:10px;\r\n\r\n    font-size:16px;\r\n\r\n    font-weight:bold;\r\n\r\n    color:var(--ifi-primary-dark);\r\n\r\n}\r\n\r\n/*=============================================================\r\n=            BADGES FORMAS DE PAGO                            =\r\n=============================================================*/\r\n\r\n.payment-badge{\r\n\r\n    display:inline-block;\r\n\r\n    padding:6px 12px;\r\n\r\n    border-radius:20px;\r\n\r\n    font-size:10px;\r\n\r\n    font-weight:bold;\r\n\r\n    text-transform:uppercase;\r\n\r\n    letter-spacing:.5px;\r\n\r\n}\r\n\r\n.badge-efectivo{\r\n\r\n    background:#dff7e6;\r\n\r\n    color:#1b5e20;\r\n\r\n}\r\n\r\n.badge-transferencia{\r\n\r\n    background:#e8f1fd;\r\n\r\n    color:#0d47a1;\r\n\r\n}\r\n\r\n.badge-pse{\r\n\r\n    background:#ede7ff;\r\n\r\n    color:#512da8;\r\n\r\n}\r\n\r\n.badge-wompi{\r\n\r\n    background:#f3e5f5;\r\n\r\n    color:#7b1fa2;\r\n\r\n}\r\n\r\n.badge-otro{\r\n\r\n    background:#eceff1;\r\n\r\n    color:#37474f;\r\n\r\n}\r\n\r\n/*=============================================================\r\n=            OBSERVACIONES                                    =\r\n=============================================================*/\r\n\r\n.obs{\r\n\r\n    margin-top:6px;\r\n\r\n    color:#6b7280;\r\n\r\n    font-size:10px;\r\n\r\n    font-style:italic;\r\n\r\n}\r\n\r\n/*=============================================================\r\n=            BARRA DE CONCEPTOS                               =\r\n=============================================================*/\r\n\r\n.concept-summary{\r\n\r\n    margin-top:10px;\r\n\r\n    display:flex;\r\n\r\n    justify-content:space-between;\r\n\r\n    align-items:center;\r\n\r\n    background:#f8fafc;\r\n\r\n    border:1px solid var(--ifi-border);\r\n\r\n    border-radius:6px;\r\n\r\n    padding:8px 12px;\r\n\r\n}\r\n\r\n.concept-count{\r\n\r\n    color:#1b365d;\r\n\r\n    font-weight:bold;\r\n\r\n}\r\n\r\n.bank-info{\r\n\r\n    color:#6b7280;\r\n\r\n    font-size:11px;\r\n\r\n}\r\n\r\n/*=============================================================\r\n=            RESUMEN COMPACTO                                 =\r\n=============================================================*/\r\n\r\n.recibo-resumen{\r\n\r\n    display:flex;\r\n\r\n    align-items:center;\r\n\r\n    gap:14px;\r\n\r\n    flex-wrap:wrap;\r\n\r\n    padding:4px 0 8px 0;\r\n\r\n    border-bottom:1px dashed var(--ifi-border);\r\n\r\n    margin-bottom:8px;\r\n\r\n}\r\n\r\n.recibo-resumen span{\r\n\r\n    font-size:11px;\r\n\r\n}\r\n\r\n.r-name{\r\n\r\n    flex:1;\r\n\r\n\r\n}\r\n\r\n\r\n/*=========================================================\r\n=            DETALLE V5                                   =\r\n=========================================================*/\r\n\r\n.detalle-v5{\r\n\r\n    width:100%;\r\n    border-collapse:collapse;\r\n    margin-top:12px;\r\n    font-size:10px;\r\n\r\n}\r\n\r\n.detalle-v5 thead th{\r\n\r\n    background:var(--ifi-primary-dark);\r\n    color:white;\r\n    padding:5px;\r\n    font-size:10px;\r\n    font-weight:600;\r\n\r\n}\r\n\r\n.detalle-v5 td{\r\n\r\n    vertical-align:top;\r\n    padding:5px 8px;\r\n    border:none;\r\n\r\n}\r\n\r\n.detalle-v5 tbody tr{\r\n\r\n    page-break-inside:avoid;\r\n\r\n}\r\n\r\n.detalle-v5 tbody tr{\r\n\r\n    border-bottom:1px solid #d8e0ea;\r\n\r\n}\r\n\r\n.recibo-num{\r\n\r\n    font-weight:bold;\r\n    color:var(--ifi-primary-dark);\r\n    font-size:11px;\r\n\r\n}\r\n\r\n.recibo-fecha{\r\n\r\n    color:#6b7280;\r\n    font-size:9px;\r\n\r\n}\r\n\r\n.feligres{\r\n\r\n   font-weight:600;\r\n    line-height:1.05;\r\n\r\n}\r\n\r\n.documento{\r\n\r\n    color:#7a7a7a;\r\n    font-size:8px;\r\n    margin-top:1px;\r\n\r\n}\r\n\r\n.pago{\r\n\r\n    font-weight:600;\r\n    line-height:1.3;\r\n\r\n}\r\n\r\n.banco{\r\n\r\n    color:#6b7280;\r\n    font-size:9px;\r\n\r\n}\r\n\r\n\r\n.total-columna{\r\n\r\n    text-align:right;\r\n    font-weight:bold;\r\n    color:var(--ifi-primary-dark);\r\n    white-space:nowrap;\r\n\r\n}\r\n\r\n/*=========================================================\r\n=            DETALLE RECIBO V5.1                          =\r\n=========================================================*/\r\n\r\n.detalle-linea{\r\n\r\n    display:flex;\r\n\r\n    justify-content:space-between;\r\n\r\n    align-items:flex-start;\r\n\r\n    gap:12px;\r\n\r\n    padding:1px 0;\r\n\r\n}\r\n\r\n.detalle-texto{\r\n\r\n    flex:1;\r\n\r\n    line-height:1.2;\r\n\r\n}\r\n\r\n.detalle-sub{\r\n\r\n    color:#7b7b7b;\r\n\r\n    font-size:9px;\r\n\r\n    margin-left:4px;\r\n\r\n}\r\n\r\n.detalle-valor{\r\n\r\n    white-space:nowrap;\r\n\r\n    font-weight:600;\r\n\r\n    text-align:right;\r\n\r\n}\r\n\r\n.detalle-total{\r\n\r\n    display:flex;\r\n\r\n    justify-content:space-between;\r\n\r\n    margin-top:3px;\r\n\r\n    padding-top:3px;\r\n\r\n    border-top:1px solid #d8dee9;\r\n\r\n    font-size:10px;\r\n\r\n    font-weight:bold;\r\n\r\n    color:var(--ifi-primary-dark);\r\n\r\n}\r\n\r\n\r\n</style>\r\n\r\n<!-- ===================================================== -->\r\n<!-- DETALLE DE RECIBOS V5 -->\r\n<!-- ===================================================== -->\r\n\r\n<table class=\"detalle-v5\">\r\n\r\n<thead>\r\n\r\n<tr>\r\n\r\n<th width=\"13%\">Recibo</th>\r\n\r\n<th width=\"32%\">Donante</th>\r\n\r\n<th width=\"55%\">Detalle del Recibo</th>\r\n\r\n\r\n</tr>\r\n\r\n</thead>\r\n\r\n<tbody>\r\n\r\n{% for fila in doc.donaciones %}\r\n\r\n{% set recibo = frappe.get_doc(\"Donacion\", fila.donacion) %}\r\n\r\n<tr>\r\n\r\n<td>\r\n\r\n<div class=\"recibo-num\">\r\n\r\n{{ recibo.name }}\r\n\r\n</div>\r\n\r\n<div class=\"recibo-fecha\">\r\n\r\n{{ frappe.utils.formatdate(recibo.fecha) }}\r\n\r\n</div>\r\n\r\n</td>\r\n\r\n<td>\r\n\r\n<div class=\"feligres\">\r\n\r\n{{ recibo.nombre }}\r\n\r\n</div>\r\n\r\n<div class=\"documento\">\r\n\r\nCC {{ recibo.identificacion }}\r\n\r\n&nbsp;&nbsp;•&nbsp;&nbsp;\r\n\r\n<strong>{{ recibo.forma_de_pago }}</strong>\r\n\r\n{% if recibo.banco_recaudo %}\r\n\r\n&nbsp;·&nbsp;\r\n\r\n{{ recibo.banco_recaudo }}\r\n\r\n{% endif %}\r\n\r\n</div>\r\n\r\n</td>\r\n\r\n<td>\r\n\r\n{% for c in recibo.conceptos_de_donacion %}\r\n\r\n<div class=\"detalle-linea\">\r\n\r\n    <div class=\"detalle-texto\">\r\n\r\n        <strong>{{ c.concepto }}</strong>\r\n\r\n        {% if c.subconcepto %}\r\n            <span class=\"detalle-sub\">\r\n                • {{ c.subconcepto }}\r\n            </span>\r\n        {% endif %}\r\n\r\n    </div>\r\n\r\n    <div class=\"detalle-valor\">\r\n\r\n        {{ frappe.format_value(c.valor,\"Currency\") }}\r\n\r\n    </div>\r\n\r\n</div>\r\n\r\n{% endfor %}\r\n\r\n<div class=\"detalle-total\">\r\n\r\n    <span>TOTAL</span>\r\n\r\n    <span>{{ frappe.format_value(recibo.total,\"Currency\") }}</span>\r\n\r\n</div>\r\n\r\n</td>\r\n\r\n\r\n</tr>\r\n\r\n{% endfor %}\r\n\r\n</tbody>\r\n\r\n</table>\r\n\r\n\r\n\r\n<style>\r\n\r\n/*=============================================================\r\n=            RESUMEN EJECUTIVO                                =\r\n=============================================================*/\r\n\r\n.executive-section{\r\n\r\n    margin-top:25px;\r\n\r\n}\r\n\r\n.executive-title{\r\n\r\n    background:var(--ifi-primary-dark);\r\n\r\n    color:white;\r\n\r\n    padding:10px 14px;\r\n\r\n    font-size:14px;\r\n\r\n    font-weight:bold;\r\n\r\n    border-radius:8px 8px 0 0;\r\n\r\n}\r\n\r\n.executive-grid{\r\n\r\n    display:flex;\r\n\r\n    gap:12px;\r\n\r\n    margin-top:10px;\r\n\r\n}\r\n\r\n.executive-card{\r\n\r\n    flex:1;\r\n\r\n    border:1px solid var(--ifi-border);\r\n\r\n    border-radius:8px;\r\n\r\n    overflow:hidden;\r\n\r\n    background:white;\r\n\r\n}\r\n\r\n.executive-card h3{\r\n\r\n    background:#eef5fb;\r\n\r\n    padding:8px;\r\n\r\n    margin:0;\r\n\r\n    color:#1b365d;\r\n\r\n    font-size:12px;\r\n\r\n}\r\n\r\n.executive-card table{\r\n\r\n    width:100%;\r\n\r\n    border-collapse:collapse;\r\n\r\n}\r\n\r\n.executive-card td{\r\n\r\n    border:none;\r\n\r\n    padding:6px 10px;\r\n\r\n}\r\n\r\n.executive-total{\r\n\r\n    font-size:22px;\r\n\r\n    font-weight:bold;\r\n\r\n    color:var(--ifi-primary-dark);\r\n\r\n    text-align:center;\r\n\r\n    padding:20px;\r\n\r\n}\r\n\r\n/*=============================================================\r\n=            ESTADO EJECUTIVO                                 =\r\n=============================================================*/\r\n\r\n.executive-status{\r\n\r\n    margin-top:20px;\r\n\r\n    border-radius:8px;\r\n\r\n    padding:18px;\r\n\r\n    border:2px solid;\r\n\r\n}\r\n\r\n.executive-status.ok{\r\n\r\n    background:#eefaf1;\r\n\r\n    border-color:#4caf50;\r\n\r\n}\r\n\r\n.executive-status.warn{\r\n\r\n    background:#fff8e6;\r\n\r\n    border-color:#ff9800;\r\n\r\n}\r\n\r\n.executive-status.error{\r\n\r\n    background:#fdecea;\r\n\r\n    border-color:#e53935;\r\n\r\n}\r\n\r\n.executive-status-title{\r\n\r\n    font-size:20px;\r\n\r\n    font-weight:bold;\r\n\r\n    margin-bottom:8px;\r\n\r\n}\r\n\r\n.executive-status-message{\r\n\r\n    font-size:12px;\r\n\r\n    line-height:1.6;\r\n\r\n}\r\n\r\n.summary-row{\r\n\r\n    display:flex;\r\n\r\n    justify-content:space-between;\r\n\r\n    margin-top:8px;\r\n\r\n}\r\n\r\n.summary-pill{\r\n\r\n    padding:6px 12px;\r\n\r\n    border-radius:16px;\r\n\r\n    background:white;\r\n\r\n    border:1px solid var(--ifi-border);\r\n\r\n    font-size:11px;\r\n\r\n    font-weight:600;\r\n\r\n}\r\n</style>\r\n\r\n<!-- ========================================================= -->\r\n<!-- RESUMEN EJECUTIVO -->\r\n<!-- ========================================================= -->\r\n\r\n{% set ns = namespace(\r\n    efectivo=0,\r\n    transferencia=0,\r\n    pse=0,\r\n    wompi=0,\r\n    otros=0\r\n) %}\r\n\r\n{% for fila in doc.donaciones %}\r\n\r\n    {% set r = frappe.get_doc(\"Donacion\", fila.donacion) %}\r\n\r\n    {% if r.forma_de_pago==\"Efectivo\" %}\r\n        {% set ns.efectivo = ns.efectivo + (r.total or 0) %}\r\n    {% elif r.forma_de_pago==\"Transferencia\" %}\r\n        {% set ns.transferencia = ns.transferencia + (r.total or 0) %}\r\n    {% elif r.forma_de_pago==\"PSE\" %}\r\n        {% set ns.pse = ns.pse + (r.total or 0) %}\r\n    {% elif r.forma_de_pago==\"Wompi\" %}\r\n        {% set ns.wompi = ns.wompi + (r.total or 0) %}\r\n    {% else %}\r\n        {% set ns.otros = ns.otros + (r.total or 0) %}\r\n    {% endif %}\r\n\r\n{% endfor %}\r\n\r\n<div class=\"executive-section\">\r\n\r\n<div class=\"executive-title\">\r\n\r\nRESUMEN EJECUTIVO DE LA PLANILLA\r\n\r\n</div>\r\n\r\n<div class=\"executive-grid\">\r\n\r\n<div class=\"executive-card\">\r\n\r\n<h3>\r\n\r\nINDICADORES\r\n\r\n</h3>\r\n\r\n<div class=\"executive-total\">\r\n\r\n{{ doc.donaciones|length }}\r\n\r\n</div>\r\n\r\n<div style=\"text-align:center;padding-bottom:15px;\">\r\n\r\nRecibos registrados\r\n\r\n</div>\r\n\r\n</div>\r\n\r\n<div class=\"executive-card\">\r\n\r\n<h3>\r\n\r\nFORMAS DE PAGO\r\n\r\n</h3>\r\n\r\n<table>\r\n\r\n<tr>\r\n\r\n<td>Efectivo</td>\r\n\r\n<td class=\"text-right\">\r\n\r\n{{ frappe.format_value(ns.efectivo,\"Currency\") }}\r\n\r\n</td>\r\n\r\n</tr>\r\n\r\n<tr>\r\n\r\n<td>Transferencia</td>\r\n\r\n<td class=\"text-right\">\r\n\r\n{{ frappe.format_value(ns.transferencia,\"Currency\") }}\r\n\r\n</td>\r\n\r\n</tr>\r\n\r\n<tr>\r\n\r\n<td>PSE</td>\r\n\r\n<td class=\"text-right\">\r\n\r\n{{ frappe.format_value(ns.pse,\"Currency\") }}\r\n\r\n</td>\r\n\r\n</tr>\r\n\r\n<tr>\r\n\r\n<td>Wompi</td>\r\n\r\n<td class=\"text-right\">\r\n\r\n{{ frappe.format_value(ns.wompi,\"Currency\") }}\r\n\r\n</td>\r\n\r\n</tr>\r\n\r\n<tr>\r\n\r\n<td>Otros</td>\r\n\r\n<td class=\"text-right\">\r\n\r\n{{ frappe.format_value(ns.otros,\"Currency\") }}\r\n\r\n</td>\r\n\r\n</tr>\r\n\r\n</table>\r\n\r\n</div>\r\n\r\n<div class=\"executive-card\">\r\n\r\n<h3>\r\n\r\nTOTALES\r\n\r\n</h3>\r\n\r\n<table>\r\n\r\n<tr>\r\n\r\n<td>Total Recaudado</td>\r\n\r\n<td class=\"text-right\">\r\n\r\n<b>\r\n\r\n{{ frappe.format_value(doc.total_recaudado,\"Currency\") }}\r\n\r\n</b>\r\n\r\n</td>\r\n\r\n</tr>\r\n\r\n<tr>\r\n\r\n<td>Total Consignado</td>\r\n\r\n<td class=\"text-right\">\r\n\r\n<b>\r\n\r\n{{ frappe.format_value(doc.total_consignado,\"Currency\") }}\r\n\r\n</b>\r\n\r\n</td>\r\n\r\n</tr>\r\n\r\n<tr>\r\n\r\n<td>Diferencia</td>\r\n\r\n<td class=\"text-right\">\r\n\r\n<b>\r\n\r\n{{ frappe.format_value(doc.diferencia_consignacion,\"Currency\") }}\r\n\r\n</b>\r\n\r\n</td>\r\n\r\n</tr>\r\n\r\n</table>\r\n\r\n</div>\r\n\r\n</div>\r\n\r\n</div>\r\n\r\n<!-- ========================================================= -->\r\n<!-- ESTADO EJECUTIVO -->\r\n<!-- ========================================================= -->\r\n\r\n{% set diferencia = doc.diferencia_consignacion or 0 %}\r\n\r\n{% if diferencia == 0 %}\r\n\r\n<div class=\"executive-status ok\">\r\n\r\n<div class=\"executive-status-title\">\r\n\r\n✅ PLANILLA CUADRADA\r\n\r\n</div>\r\n\r\n<div class=\"executive-status-message\">\r\n\r\nEl total recaudado coincide exactamente con el total consignado.\r\n\r\nNo existen diferencias contables.\r\n\r\n</div>\r\n\r\n</div>\r\n\r\n{% elif diferencia > 0 %}\r\n\r\n<div class=\"executive-status warn\">\r\n\r\n<div class=\"executive-status-title\">\r\n\r\n⚠ DIFERENCIA POR CONSIGNAR\r\n\r\n</div>\r\n\r\n<div class=\"executive-status-message\">\r\n\r\nExiste dinero pendiente por consignar.\r\n\r\n</div>\r\n\r\n<div class=\"summary-row\">\r\n\r\n<div class=\"summary-pill\">\r\n\r\nPendiente\r\n\r\n</div>\r\n\r\n<div class=\"summary-pill\">\r\n\r\n{{ frappe.format_value(diferencia,\"Currency\") }}\r\n\r\n</div>\r\n\r\n</div>\r\n\r\n</div>\r\n\r\n{% else %}\r\n\r\n<div class=\"executive-status error\">\r\n\r\n<div class=\"executive-status-title\">\r\n\r\n🚨 CONSIGNACIÓN SUPERIOR AL RECAUDO\r\n\r\n</div>\r\n\r\n<div class=\"executive-status-message\">\r\n\r\nLa consignación supera el dinero registrado en la planilla.\r\n\r\nSe recomienda revisar inmediatamente la información.\r\n\r\n</div>\r\n\r\n<div class=\"summary-row\">\r\n\r\n<div class=\"summary-pill\">\r\n\r\nDiferencia\r\n\r\n</div>\r\n\r\n<div class=\"summary-pill\">\r\n\r\n{{ frappe.format_value(diferencia,\"Currency\") }}\r\n\r\n</div>\r\n\r\n</div>\r\n\r\n</div>\r\n\r\n{% endif %}\r\n\r\n<!-- ========================================================= -->\r\n<!-- INDICADORES VISUALES -->\r\n<!-- ========================================================= -->\r\n\r\n<div class=\"executive-grid mt-20\">\r\n\r\n<div class=\"executive-card\">\r\n\r\n<h3>RECAUDO</h3>\r\n\r\n<div class=\"executive-total\">\r\n\r\n{{ frappe.format_value(doc.total_recaudado,\"Currency\") }}\r\n\r\n</div>\r\n\r\n</div>\r\n\r\n<div class=\"executive-card\">\r\n\r\n<h3>CONSIGNADO</h3>\r\n\r\n<div class=\"executive-total\">\r\n\r\n{{ frappe.format_value(doc.total_consignado,\"Currency\") }}\r\n\r\n</div>\r\n\r\n</div>\r\n\r\n<div class=\"executive-card\">\r\n\r\n<h3>RECIBOS</h3>\r\n\r\n<div class=\"executive-total\">\r\n\r\n{{ doc.donaciones|length }}\r\n\r\n</div>\r\n\r\n</div>\r\n\r\n</div>",
